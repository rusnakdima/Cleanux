@startuml
title Cleanux — TO-BE Deployment Architecture (Post-Migration)
skinparam componentStyle rectangle

package "Dioxus Webview (Embedded)" {
  [Dioxus SSR/Hydration] as dioxus
  [pages/]
  [components/]
  [hooks/]
}

package "DDD Layers" {
  package "src/domain/" #LightGreen {
    [entities/]
    [value_objects/]
    [services/]
  }
  package "src/application/" #LightYellow {
    [services/]
    [kas/ handlers]
  }
  package "src/infrastructure/" #LightPink {
    [persistence/]
    [cleanup/]
    [monitoring/]
  }
}

package "dioxus-shared" #Orange {
  [themes/]
  [ui/render_component.rs]
  [algorithms/]
  [schema/]
}

package "Tauri Backend (Thin IPC)" #Gray {
  [tauri::generate_handler![]]
  [tauri_plugin_mcp_bridge]
  [No business logic]
}

package "Data Layer" {
  [nosql_orm]
  database "JSON Files" as json_db {
    folder "app_data_dir()"
  }
}

dioxus --> domain
dioxus --> application
dioxus --> infrastructure
dioxus --> dioxus-shared
application --> domain
infrastructure --> dioxus-shared
Tauri Backend --> dioxus-shared
infrastructure --> nosql_orm
nosql_orm --> json_db

note bottom of Tauri Backend
  Migration complete: Tauri is ONLY an IPC bridge
  dioxus-shared provides theming, rendering, schemas
  Frontend served via Dioxus webview
end note

note bottom of Dioxus Webview
  Optional: Separate dx serve for development
  Embedded webview for production builds
end note
@enduml
