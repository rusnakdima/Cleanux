@startuml
title Cleanux — TO-BE Sequence: Profile Apply Flow (KAS)
participant "Dioxus Frontend" as FE
participant "kas_handler\napply_cleaning_profile" as KAS
participant "CleaningApplicationService" as APP
participant "ProfileDomainService" as DOMAIN
participant "RepositoryService" as REPO
database "JSON Files" as DB

FE -> KAS : apply_cleaning_profile(name)
KAS -> APP : apply_profile(name)

alt Fetch Profile
  APP -> DOMAIN : get_profile(name)
  DOMAIN -> REPO : find_by_id("cleaning_profiles", id)
  REPO -> DB : read JSON
end

alt Execute Cleaning
  APP -> APP : execute_cache_clean()
  APP -> APP : execute_trash_clean()
  APP -> APP : execute_log_clean()

  alt needs_elevated
    APP -> KAS : require_elevation()
    KAS -> FE : show elevation prompt
  end
end

KAS --> FE : KasResponse::success(results)

note right of KAS
  KAS handlers replace tauri::command
  Separation: invoke (data) vs navigate (page)
  All business logic in application/domain layers
end note
@enduml
